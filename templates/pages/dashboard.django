{% extends "base.django" %}
{% load static %}
{% block page_id %}dashboard{% endblock %}
{% block content %}
<div class="mx-auto flex max-w-6xl flex-col gap-6">

  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-base font-medium">Welcome back, {{ request.user.username|default:"there" }}!</h2>
      <p class="text-sm text-muted-foreground">Let's manage all of your online storage.</p>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" class="btn" data-variant="secondary">
        {% include "components/shared/icon.django" with name="upload" %}Upload
      </button>
      <div class="dropdown-menu">
        <button type="button" id="create-trigger" class="btn" data-variant="secondary" aria-haspopup="menu" aria-controls="create-menu" aria-expanded="false">
          {% include "components/shared/icon.django" with name="plus" %}Create
        </button>
        <div id="create-popover" data-popover aria-hidden="true" data-align="end">
          <div role="menu" id="create-menu" aria-labelledby="create-trigger">
            <button type="button" role="menuitem">{% include "components/shared/icon.django" with name="folder-plus" %}New folder</button>
            <button type="button" role="menuitem">{% include "components/shared/icon.django" with name="upload" %}Upload files</button>
            <button type="button" role="menuitem">{% include "components/shared/icon.django" with name="folder" %}Upload folder</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-5">
    <div class="grid grid-cols-3 gap-4 lg:col-span-3">
      {% for folder in folders %}
      <a href="{% url 'files_browser' %}?type={{ folder.name|lower }}" class="card transition-colors hover:bg-muted/50" data-size="sm">
        <section class="flex justify-center py-4 text-muted-foreground">
          {% include "components/shared/icon.django" with name="folder" class="size-14 fill-muted stroke-1" %}
        </section>
        <section>
          <p class="text-sm font-medium">{{ folder.name }}</p>
          <p class="text-xs text-muted-foreground">{{ folder.count }} files</p>
        </section>
      </a>
      {% endfor %}
    </div>

    <div class="card lg:col-span-2" data-size="sm">
      <header><p>Storage overview</p></header>
      <section class="flex flex-col gap-3">
        <p class="text-lg font-semibold">{{ storage.used }} <span class="text-sm font-normal text-muted-foreground">of {{ storage.total }}</span></p>
        <div class="flex h-2 overflow-hidden rounded-full bg-muted">
          {% for seg in storage.segments %}
          <span class="{{ seg.color }}" style="width: {{ seg.percent|floatformat:'1u' }}%"></span>
          {% endfor %}
        </div>
        <ul class="grid grid-flow-col grid-rows-2 gap-x-6 gap-y-1.5 text-xs">
          {% for seg in storage.segments %}
          <li class="flex items-center gap-2">
            <span class="size-2 rounded-full {{ seg.color }}"></span>
            <span class="text-muted-foreground">{{ seg.label }}</span>
            <span class="ml-auto font-mono">{{ seg.size }}</span>
          </li>
          {% endfor %}
        </ul>
      </section>
      <footer class="border-t px-4 pt-4 text-xs text-muted-foreground">
        {{ storage.used_percent }}% storage used, review heavy files to organize.
      </footer>
    </div>
  </div>

  <div class="card" data-size="sm">
    <header>
      <p>Recent files</p>
      <a href="{% url 'recent' %}" class="card-action text-xs text-muted-foreground hover:text-foreground">View All</a>
    </header>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th class="w-10 pl-4"><input type="checkbox" class="input" aria-label="Select all files"></th>
            <th>Name</th>
            <th class="hidden md:table-cell">Folder</th>
            <th class="hidden sm:table-cell">Size</th>
            <th class="hidden md:table-cell">Modified</th>
            <th class="w-20"></th>
          </tr>
        </thead>
        <tbody>
          {% for f in recent_files %}
          <tr>
            <td class="pl-4"><input type="checkbox" class="input" aria-label="Select {{ f.name }}"></td>
            <td>
              <span class="flex items-center gap-2">
                {% include "components/shared/icon.django" with name="file" class=f.icon_class %}
                {{ f.name }}
              </span>
            </td>
            <td class="hidden md:table-cell"><span class="badge" data-variant="secondary">{{ f.folder }}</span></td>
            <td class="hidden text-muted-foreground sm:table-cell">{{ f.size }}</td>
            <td class="hidden text-muted-foreground md:table-cell">{{ f.modified }}</td>
            <td>
              <span class="flex items-center justify-end gap-1 pr-2">
                <button type="button" class="btn" data-variant="ghost" data-size="icon-xs" aria-label="Toggle star">
                  {% if f.starred %}
                    {% include "components/shared/icon.django" with name="star" class="fill-amber-400 text-amber-400" %}
                  {% else %}
                    {% include "components/shared/icon.django" with name="star" class="text-muted-foreground" %}
                  {% endif %}
                </button>
                <button type="button" class="btn" data-variant="ghost" data-size="icon-xs" aria-label="More actions">
                  {% include "components/shared/icon.django" with name="ellipsis" %}
                </button>
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <footer class="justify-between border-t px-4 pt-4 text-xs text-muted-foreground">
      <span>{{ total_files }} files &nbsp; {{ total_size }}</span>
      <span class="flex items-center gap-1">
        <button type="button" class="btn" data-variant="secondary" data-size="icon-xs" aria-current="page">1</button>
        <button type="button" class="btn" data-variant="ghost" data-size="icon-xs">2</button>
        <button type="button" class="btn" data-variant="ghost" data-size="icon-xs">3</button>
        <span>…</span>
        <button type="button" class="btn" data-variant="ghost" data-size="icon-xs">12</button>
      </span>
    </footer>
  </div>

</div>
{% endblock %}